<Window x:Class="GymManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GymManagement"
        xmlns:viewmodels="clr-namespace:GymManagement.ViewModels"
        xmlns:services="clr-namespace:GymManagement.Services"
        xmlns:properties="clr-namespace:GymManagement.Properties"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="{x:Static properties:Resources.AppTitle}" 
        Height="700" Width="1200"
        FontFamily="Segoe UI"
        Background="#F4F7FC">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,10,0,15"/>
        </Style>

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#CCCCCC" Direction="270" ShadowDepth="2" Opacity="0.3" BlurRadius="5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="#1ABC9C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#17A88A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#34495E" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static properties:Resources.AppTitle}" 
                               Foreground="White" FontSize="20" FontWeight="Bold"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static properties:Resources.Language}" Foreground="White" 
                                     Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox Name="LanguageComboBox" Width="120" 
                                     SelectionChanged="LanguageComboBox_SelectionChanged"
                                     SelectedIndex="0">
                        <ComboBoxItem Content="{x:Static properties:Resources.Language_English}" Tag="en"/>
                        <ComboBoxItem Content="{x:Static properties:Resources.Language_Russian}" Tag="ru"/>
                        <ComboBoxItem Content="{x:Static properties:Resources.Language_Uzbek}" Tag="uz"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="10" Background="Transparent" BorderThickness="0">

            <TabItem Header="{x:Static properties:Resources.TabDashboard}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.ChartSummary}" 
                               FontSize="24" FontWeight="Bold" Foreground="#3F51B5" Margin="0,0,0,15"/>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="10" Padding="15" Background="White" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.ChartAttendanceTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                <lvc:CartesianChart Series="{Binding AttendanceSeries}" Height="250">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="{x:Static properties:Resources.ChartCustomer}" Labels="{Binding AttendanceLabels}" 
                                                    FontSize="10" Foreground="#607D8B" Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="{x:Static properties:Resources.ChartVisits}" LabelFormatter="{Binding ChartVisitFormatter}" 
                                                    FontSize="10" Foreground="#607D8B"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="10" Padding="15" Background="White" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.ChartSalesDistributionTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                <lvc:PieChart Series="{Binding SalesSeries}" LegendLocation="Right" Height="144" Width="475">
                                    <lvc:PieChart.DataTooltip>
                                        <lvc:DefaultTooltip BulletSize="20"/>
                                    </lvc:PieChart.DataTooltip>
                                </lvc:PieChart>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Margin="10" Padding="15" Background="White" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.ChartInventoryStatusTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                            <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding FilteredProducts}" IsReadOnly="True" MaxHeight="250"
                              RowDetailsVisibilityMode="Collapsed" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.HeaderProductName}" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.HeaderStockQuantity}" Binding="{Binding StockQuantity}" Width="*"/>
                                    <DataGridTemplateColumn Header="{x:Static properties:Resources.HeaderStockStatus}" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StockStatus}" Padding="5" 
                                                      Foreground="{Binding StockStatus}"
                                                      FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>


            <TabItem Header="{x:Static properties:Resources.TabCustomers}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.CustomerList}" Style="{StaticResource HeaderStyle}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border CornerRadius="5" BorderThickness="1" BorderBrush="#BDC3C7">
                                    <TextBox Text="{Binding CustomerFilterText, UpdateSourceTrigger=PropertyChanged}" 
                                                 Height="30" Padding="5" BorderThickness="0"
                                                 services:WatermarkService.Watermark="{x:Static properties:Resources.CustomerSearchHint}"/>
                                </Border>

                                <Button Grid.Column="1" Content="{x:Static properties:Resources.Clear}" 
                                              Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"
                                              Command="{Binding LoadDataCommand}"/>
                            </Grid>

                            <DataGrid ItemsSource="{Binding FilteredCustomers}" 
                                            AutoGenerateColumns="False" 
                                            IsReadOnly="False" 
                                            Height="400"
                                            CanUserAddRows="False"
                                            HeadersVisibility="Column"
                                            Background="White"
                                            RowEditEnding="DataGrid_RowEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="Auto"/>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.CustomerName}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.CustomerPhone}" Binding="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.CustomerEmail}" Binding="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                    <DataGridTemplateColumn Width="Auto" Header="{x:Static properties:Resources.Action}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{x:Static properties:Resources.Save}" 
                                                            Style="{StaticResource PrimaryButtonStyle}" 
                                                            Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}, Path=DataContext.UpdateCustomerCommand}"
                                                            CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.CustomerAdd}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                <TextBlock Text="{x:Static properties:Resources.CustomerName}"/>

                                <Border CornerRadius="5" BorderThickness="1" BorderBrush="#BDC3C7" Margin="0,5,0,10">
                                    <TextBox Text="{Binding NewCustomer.Name}" Padding="5" BorderThickness="0"/>
                                </Border>

                                <TextBlock Text="{x:Static properties:Resources.CustomerPhone}"/>
                                <Border CornerRadius="5" BorderThickness="1" BorderBrush="#BDC3C7" Margin="0,5,0,10">
                                    <TextBox Text="{Binding NewCustomer.Phone}" Padding="5" BorderThickness="0"/>
                                </Border>

                                <TextBlock Text="{x:Static properties:Resources.CustomerEmail}"/>
                                <Border CornerRadius="5" BorderThickness="1" BorderBrush="#BDC3C7" Margin="0,5,0,10">
                                    <TextBox Text="{Binding NewCustomer.Email}" Padding="5" BorderThickness="0"/>
                                </Border>

                                <Button Content="{x:Static properties:Resources.CustomerAddButton}" 
                                              Style="{StaticResource PrimaryButtonStyle}" 
                                              Command="{Binding AddCustomerCommand}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="5,15,5,5">
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.CustomerCheckIn}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                <ComboBox ItemsSource="{Binding Customers}" 
                                                 DisplayMemberPath="Name"
                                                 SelectedItem="{Binding SelectedCustomerForCheckIn}"
                                                 Height="30" Margin="0,5,0,10"/>
                                <Button Content="{x:Static properties:Resources.CheckInButton}" 
                                              Style="{StaticResource PrimaryButtonStyle}" 
                                              Command="{Binding CheckInCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static properties:Resources.TabInventory}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.InventoryList}" Style="{StaticResource HeaderStyle}"/>

                            <DataGrid ItemsSource="{Binding FilteredProducts}" 
                                            AutoGenerateColumns="False" 
                                            IsReadOnly="False" 
                                            Height="400"
                                            CanUserAddRows="False"
                                            HeadersVisibility="Column"
                                            Background="White"
                                            RowEditEnding="DataGrid_RowEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="Auto"/>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.ProductName}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.ProductPrice}" Binding="{Binding Price, StringFormat=C2, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.ProductStock}" Binding="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                                    <DataGridTemplateColumn Header="{x:Static properties:Resources.ProductStatus}" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StockStatus}" 
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding StockStatus}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="Auto" Header="{x:Static properties:Resources.Action}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{x:Static properties:Resources.Save}" 
                                                            Style="{StaticResource PrimaryButtonStyle}" 
                                                            Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}, Path=DataContext.UpdateProductCommand}"
                                                            CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.ProductAdd}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                <TextBlock Text="{x:Static properties:Resources.ProductName}"/>
                                <Border CornerRadius="5" BorderThickness="1" BorderBrush="#BDC3C7" Margin="0,5,0,10">
                                    <TextBox Text="{Binding NewProduct.Name}" Padding="5" BorderThickness="0"/>
                                </Border>

                                <TextBlock Text="{x:Static properties:Resources.ProductPrice}"/>
                                <Border CornerRadius="5" BorderThickness="1" BorderBrush="#BDC3C7" Margin="0,5,0,10">
                                    <TextBox Text="{Binding NewProduct.Price}" Padding="5" BorderThickness="0"/>
                                </Border>

                                <TextBlock Text="{x:Static properties:Resources.ProductStock}"/>
                                <Border CornerRadius="5" BorderThickness="1" BorderBrush="#BDC3C7" Margin="0,5,0,10">
                                    <TextBox Text="{Binding NewProduct.StockQuantity}" Padding="5" BorderThickness="0"/>
                                </Border>

                                <Button Content="{x:Static properties:Resources.ProductAddButton}" 
                                              Style="{StaticResource PrimaryButtonStyle}" 
                                              Command="{Binding AddProductCommand}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static properties:Resources.TabTransactions}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{x:Static properties:Resources.PurchaseNew}" Style="{StaticResource HeaderStyle}"/>

                            <TextBlock Text="{x:Static properties:Resources.PurchaseCustomer}"/>
                            <ComboBox ItemsSource="{Binding Customers}" 
                                                 DisplayMemberPath="Name"
                                                 SelectedItem="{Binding SelectedCustomerForPurchase}"
                                                 Height="30" Margin="0,5,0,10"/>

                            <TextBlock Text="{x:Static properties:Resources.PurchaseProduct}"/>
                            <ComboBox ItemsSource="{Binding Products}" 
                                                 DisplayMemberPath="Name"
                                                 SelectedItem="{Binding SelectedProductForPurchase}"
                                                 Height="30" Margin="0,5,0,10"/>

                            <TextBlock Text="{x:Static properties:Resources.PurchaseQuantity}"/>
                            <Border CornerRadius="5" BorderThickness="1" BorderBrush="#BDC3C7" Margin="0,5,0,15">
                                <TextBox Text="{Binding PurchaseQuantity}" Padding="5" BorderThickness="0"/>
                            </Border>

                            <Button Content="{x:Static properties:Resources.PurchaseProcessButton}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Command="{Binding ProcessPurchaseCommand}"
                                          Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding PurchaseMessage}" 
                                                 Foreground="#E74C3C" 
                                                 FontWeight="SemiBold"
                                                 TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.PurchaseHistory}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding FilteredPurchases}" 
                                                 AutoGenerateColumns="False" 
                                                 IsReadOnly="True" 
                                                 MaxHeight="250"
                                                 HeadersVisibility="Column"
                                                 CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{x:Static properties:Resources.Customer}" Binding="{Binding CustomerName}" Width="*"/>
                                        <DataGridTextColumn Header="{x:Static properties:Resources.Product}" Binding="{Binding ProductName}" Width="*"/>
                                        <DataGridTextColumn Header="{x:Static properties:Resources.PurchaseQuantityShort}" Binding="{Binding Quantity}" Width="Auto"/>
                                        <DataGridTextColumn Header="{x:Static properties:Resources.Total}" Binding="{Binding TotalPrice, StringFormat=C2}" Width="Auto"/>
                                        <DataGridTextColumn Header="{x:Static properties:Resources.Date}" Binding="{Binding PurchaseDate, StringFormat='dd/MM HH:mm'}" Width="1.5*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.CheckInHistory}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding CheckIns}" 
                                                 AutoGenerateColumns="False" 
                                                 IsReadOnly="True" 
                                                 MaxHeight="250"
                                                 HeadersVisibility="Column"
                                                 CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{x:Static properties:Resources.Customer}" Binding="{Binding CustomerName}" Width="*"/>
                                        <DataGridTextColumn Header="{x:Static properties:Resources.Date}" Binding="{Binding CheckInDate, StringFormat='dd/MM HH:mm'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>